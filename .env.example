# Copy to .env. Never commit real keys or paste them into chat.
BUDDY_PROVIDER=anthropic
# Set an exact model ID available in your provider account. Required for live use.
BUDDY_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional offline provider: BUDDY_PROVIDER=ollama and BUDDY_MODEL=<installed model>
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional overrides (otherwise config.yaml applies).
# BUDDY_USER_NAME=Arpit
# BUDDY_TTS_BACKEND=say
# BUDDY_DATA_DIR=/absolute/path/to/private/buddy-data
